<template>
  <div class="page-container chat-page">
    <div class="chat-header">
      <el-button text @click="goBack" class="back-btn">鈫?杩斿洖</el-button>
      <span class="header-title">{{ currentLabel }}</span>
      <div style="width:50px"></div>
    </div>

    <div class="messages" ref="msgBox">
      <div v-if="messages.length === 0 && !loading" class="welcome">
        <div class="welcome-icon">馃尶</div>
        <div class="welcome-text">闂垜鍏充簬{{ currentLabel }}鐨勯棶棰樺惂</div>
      </div>

      <div v-for="(msg, i) in messages" :key="i" :class="'msg msg-' + msg.role">
        <div class="bubble" v-html="renderContent(msg.content)"></div>
        <div v-if="msg.role === 'assistant'" class="msg-actions">
          <el-button text size="small" @click="copyContent(msg.content)">馃搵 澶嶅埗</el-button>
          <el-button text size="small" @click="toggleFavorite(msg, i)" :type="msg._faved ? 'warning' : 'default'">
            {{ msg._faved ? '猸?宸叉敹钘? : '鈽?鏀惰棌' }}
          </el-button>
        </div>
      </div>

      <div v-if="loading" class="msg msg-assistant">
        <div class="bubble thinking">
          <span class="dot">.</span><span class="dot">.</span><span class="dot">.</span>
        </div>
      </div>
    </div>

    <div class="input-area">
      <el-input v-model="inputText" ref="inputRef" placeholder="杈撳叆浣犵殑闂..." size="large"
                @keyup.enter="send" :disabled="loading" clearable />
      <el-button type="success" :icon="Promotion" circle @click="send" :disabled="loading || !inputText.trim()" />
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted, nextTick } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { sendChat, getConversation } from '../api'
import { Promotion } from '@element-plus/icons-vue'
import { ElMessage } from 'element-plus'

const route = useRoute()
const router = useRouter()
const msgBox = ref(null)
const inputRef = ref(null)
const messages = ref([])
const inputText = ref('')
const loading = ref(false)
const convId = ref(null)
const currentScene = ref(localStorage.getItem('currentScene') || '')
const currentLabel = ref(localStorage.getItem('sceneLabel') || 'AI 鍔╂墜')

onMounted(async () => {
  await nextTick()
  inputRef.value?.focus()

  if (route.params.id) {
    convId.value = route.params.id
    try {
      const res = await getConversation(route.params.id)
      const conv = res.data
      if (conv) {
        messages.value = conv.messages || []
        currentLabel.value = conv.sceneLabel || 'AI 鍔╂墜'
        currentScene.value = conv.scene || ''
      }
      scrollBottom()
    } catch (e) {
      ElMessage.error('鍔犺浇瀵硅瘽澶辫触')
    }
  }
})

async function send() {
  const text = inputText.value.trim()
  if (!text || loading.value) return

  messages.value.push({ role: 'user', content: text })
  inputText.value = ''
  loading.value = true
  scrollBottom()

  try {
    const res = await sendChat(text, currentScene.value, convId.value)
    const reply = res.data
    messages.value.push({
      role: 'assistant',
      content: reply.content,
      _id: reply.id,
      _convId: reply.conversationId,
      _faved: false
    })
    if (!convId.value && reply.conversationId) {
      convId.value = reply.conversationId
    }
    scrollBottom()
  } catch (e) {
    ElMessage.error('璇锋眰澶辫触锛岃绋嶅悗鍐嶈瘯')
    messages.value.push({
      role: 'assistant',
      content: '鎶辨瓑锛岃姹傚嚭閿欎簡锛岃绋嶅悗鍐嶈瘯銆?
    })
  } finally {
    loading.value = false
    scrollBottom()
  }
}

function scrollBottom() {
  nextTick(() => {
    if (msgBox.value) {
      msgBox.value.scrollTop = msgBox.value.scrollHeight
    }
  })
}

function goBack() {
  router.push('/home')
}

async function copyContent(content) {
  try {
    const text = stripHtml(content)
    await navigator.clipboard.writeText(text)
    ElMessage.success('宸插鍒?)
  } catch {
    ElMessage.error('澶嶅埗澶辫触')
  }
}

function toggleFavorite(msg, index) {
  msg._faved = !msg._faved
  ElMessage.success(msg._faved ? '宸叉敹钘? : '宸插彇娑堟敹钘?)
}



function renderContent(content) {
  if (!content) return ''
  try {
    const data = JSON.parse(content)
    if (typeof data === 'object') {
      return renderStructured(data)
    }
  } catch (e) {}
  return content.replace(/\n/g, '<br>')
}

function renderStructured(data) {
  // 鑿滆氨鏍煎紡
  if (data.title && data.ingredients) {
    let html = `<div class="rc-card"><h4>${data.title}</h4>`
    if (data.difficulty || data.time || data.servings) {
      html += `<div class="rc-tags">`
      if (data.difficulty) html += `${data.difficulty}`
      if (data.time) html += ` 路 鈴憋笍 ${data.time}`
      if (data.servings) html += ` 路 ${data.servings}`
      html += `</div>`
    }
    html += `<div class="rc-sec">馃 椋熸潗</div>`
    data.ingredients.forEach(i => { html += `<div class="rc-item">路 ${i}</div>` })
    html += `<div class="rc-sec">馃懆\u200D馃嵆 姝ラ</div>`
    data.steps.forEach(s => { html += `<div class="rc-item">${s}</div>` })
    const tips = data.tips
    if (tips) {
      if (Array.isArray(tips)) {
        html += `<div class="rc-tip">${tips.map(t => '馃挕 ' + t).join('<br>')}</div>`
      } else {
        html += `<div class="rc-tip">馃挕 ${tips}</div>`
      }
    }
    html += `</div>`
    return html
  }

  // 鎸戦€夋寚鍗楁牸寮忥紙濡傛寫瑗跨摐锛?  if (data.鎸戦€夋楠?|| data.鍝佺被) {
    let html = `<div class="rc-card">`
    if (data.鍝佺被) html += `<h4>馃洅 ${data.鍝佺被}鎸戦€夋寚鍗?/h4>`
    if (data.鎸戦€夋楠? {
      data.鎸戦€夋楠?forEach(step => {
        html += `<div class="rc-guide-step">`
        html += `<div class="rc-guide-title">${step.姝ラ鍚嶇О || ''}</div>`
        html += `<div class="rc-item">${step.鍏蜂綋鎿嶄綔 || ''}</div>`
        html += `</div>`
      })
    }
    if (data.甯歌璇尯) {
      html += `<div class="rc-sec">鈿狅笍 甯歌璇尯</div>`
      data.甯歌璇尯.forEach(m => { html += `<div class="rc-item">路 ${m}</div>` })
    }
    if (data.鎬荤粨鍙ｈ瘈) {
      html += `<div class="rc-tip">馃摑 ${data.鎬荤粨鍙ｈ瘈}</div>`
    }
    html += `</div>`
    return html
  }

  // 淇悊鎸囧崡鏍煎紡
  if (data.闂 || data.宸ュ叿) {
    let html = `<div class="rc-card"><h4>馃敡 ${data.闂 || '闂鎺掓煡'}</h4>`
    if (data.宸ュ叿) {
      html += `<div class="rc-sec">馃洜锔?闇€瑕佸伐鍏?/div>`
      if (Array.isArray(data.宸ュ叿)) data.宸ュ叿.forEach(t => { html += `<div class="rc-item">路 ${t}</div>` })
      else html += `<div class="rc-item">路 ${data.宸ュ叿}</div>`
    }
    if (data.姝ラ) {
      html += `<div class="rc-sec">馃搵 姝ラ</div>`
      if (Array.isArray(data.姝ラ)) data.姝ラ.forEach(s => { html += `<div class="rc-item">${s}</div>` })
      else html += `<div class="rc-item">${data.姝ラ}</div>`
    }
    if (data.娉ㄦ剰浜嬮」) html += `<div class="rc-tip">鈿狅笍 ${data.娉ㄦ剰浜嬮」}</div>`
    html += `</div>`
    return html
  }

  // 閫氱敤 JSON 瀵硅薄娓叉煋
  let html = `<div class="rc-card">`
  for (const [key, val] of Object.entries(data)) {
    if (Array.isArray(val)) {
      html += `<div class="rc-sec">${key}</div>`
      val.forEach(v => {
        if (typeof v === 'object') {
          Object.entries(v).forEach(([k2, v2]) => {
            html += `<div class="rc-item"><strong>${k2}</strong>锛?{v2}</div>`
          })
        } else {
          html += `<div class="rc-item">路 ${v}</div>`
        }
      })
    } else if (typeof val === 'object') {
      html += `<div class="rc-sec">${key}</div>`
      Object.entries(val).forEach(([k2, v2]) => {
        html += `<div class="rc-item"><strong>${k2}</strong>锛?{v2}</div>`
      })
    } else {
      html += `<div class="rc-sec">${key}</div><div class="rc-item">${val}</div>`
    }
  }
  html += `</div>`
  return html
}
</script>

<style scoped>
.chat-page { display: flex; flex-direction: column; height: 100vh; }
.chat-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid #eee; }
.header-title { font-size: 16px; font-weight: 600; }
.back-btn { font-size: 14px; }

.messages { flex: 1; overflow-y: auto; padding: 16px 16px 8px; }
.welcome { text-align: center; padding: 60px 20px; color: #ccc; }
.welcome-icon { font-size: 48px; margin-bottom: 12px; }
.welcome-text { font-size: 15px; }

.msg { margin-bottom: 20px; }
.msg-user { text-align: right; }
.msg-user .bubble { display: inline-block; background: #22c55e; color: #fff; padding: 10px 16px; border-radius: 16px 16px 4px 16px; font-size: 14px; max-width: 85%; text-align: left; line-height: 1.6; }
.msg-assistant .bubble { display: inline-block; background: #f5f5f5; color: #333; padding: 12px 16px; border-radius: 16px 16px 16px 4px; font-size: 14px; max-width: 98%; text-align: left; line-height: 1.7; }
.msg-actions { display: flex; gap: 4px; margin-top: 4px; padding-left: 4px; }

.thinking { color: #999 !important; font-size: 24px !important; letter-spacing: 4px; }
.dot { animation: blink 1.4s infinite both; }
.dot:nth-child(2) { animation-delay: .2s; }
.dot:nth-child(3) { animation-delay: .4s; }
@keyframes blink { 0%,80%,100% { opacity: 0; } 40% { opacity: 1; } }

.input-area { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-top: 1px solid #eee; background: #fff; }

.recipe-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 12px; padding: 14px; margin: 4px 0; }
.recipe-card h4 { font-size: 16px; margin-bottom: 4px; }
.recipe-card .tags { font-size: 12px; color: #666; margin-bottom: 10px; }
.rcp-section-title { font-weight: 600; font-size: 13px; margin: 10px 0 4px; color: #444; }
.rcp-item { font-size: 13px; color: #333; margin: 5px 0; padding-left: 2px; line-height: 1.6; }
.rcp-tip { background: #fefce8; border-radius: 8px; padding: 10px; font-size: 12px; color: #a16207; margin-top: 10px; line-height: 1.6; }
</style>

