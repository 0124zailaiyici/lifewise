  width: 38px; height: 38px;
  border: 1px solid var(--line); border-radius: 15px;
  background: rgba(255,250,241,0.68);
  color: var(--accent-deep); font-size: 18px;
  display: grid; place-items: center; cursor: pointer;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.72);
}
.ghost-btn:active { transform: scale(.94); }

/* ===== 场景 Chip 横滚 ===== */
.chips {
  display: flex; gap: 8px;
  overflow-x: auto; padding: 14px 2px 4px;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.chips::-webkit-scrollbar { display: none; }
.chip {
  white-space: nowrap; flex-shrink: 0;
  border: 1px solid rgba(104,67,43,.13);
  background: rgba(255,250,241,.68);
  border-radius: 999px; padding: 8px 12px;
  color: var(--muted); font-size: 12px; cursor: pointer;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.72);
  transition: all .18s ease;
}
.chip:active { transform: scale(.96); }
.chip.active {
  color: #fff8ed;
  background: linear-gradient(135deg, #8d5f3f, #6f4b33);
  box-shadow: 0 8px 20px rgba(104,67,43,.20);
  border-color: transparent;
}

/* ===== 内容区 ===== */
.content {
  padding: 0 18px calc(80px + env(safe-area-inset-bottom, 0px));
}
