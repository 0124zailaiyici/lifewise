.ask-card {
  padding: 16px 18px;
  border-radius: var(--radius-xl);
  border: 1px solid var(--line);
  background: var(--card);
  box-shadow: var(--warm-shadow), inset 0 1px 0 rgba(255,255,255,.86);
  cursor: pointer; margin-bottom: 24px;
}
