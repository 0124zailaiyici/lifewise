  padding: 4px;
}

/* 常用问题 */
.prompt-list {
  display: flex; flex-wrap: wrap; gap: 8px;
}
.prompt-chip {
  flex: 1 1 calc(50% - 4px); min-width: 0;
  border: 1px solid var(--line);
  background: rgba(255,250,241,.48);
  color: var(--ink);
  border-radius: 999px; padding: 9px 12px;
  font-size: 12px; font-weight: 600; cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
}
.prompt-chip:active { transform: scale(.97); background: var(--card-solid); }

/* 最近问答卡片 */
.conv-card {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 16px; gap: 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--card);
  box-shadow: var(--small-shadow);
  margin-bottom: 10px; cursor: pointer;
}
.conv-card:active { transform: scale(.985); }
.conv-head { display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; }
.conv-icon {
  width: 34px; height: 34px; border-radius: 12px;
  display: grid; place-items: center;
  background: rgba(141,95,63,.08); color: var(--accent);
  font-size: 16px; flex-shrink: 0;
}
.conv-info { flex: 1; min-width: 0; }
.conv-title { font-size: 14px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.conv-meta { font-size: 11px; color: var(--muted); margin-top: 3px; }
.conv-arrow { color: var(--soft); font-size: 16px; flex-shrink: 0; }

/* 空状态 */
.empty-state { text-align: center; padding: 34px 20px 10px; }
.empty-icon { font-size: 40px; margin-bottom: 8px; }
